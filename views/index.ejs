<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SkillsUSA | York County School of Technology</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Spectral:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/home.css" />
    <link rel="stylesheet" href="/css/news.css" />
  </head>
  <body>
    <%- include('header') %>
    <main>
      <section class="hero">
        <div class="hero-media" role="img" aria-label="Students at SkillsUSA competitions"></div>
        <div class="hero-content">
          <h1>SkillsUSA Competitions</h1>
          <a class="hero-button" href="/bars">Learn More</a>
        </div>
      </section>

      <section class="why-section">
        <h2>Why SkillsUSA?</h2>
        <div class="why-grid">
          <article>
            <h3>What is SkillsUSA?</h3>
            <p>
              SkillsUSA is a top workforce development organization for students, empowering them to
              become skilled professionals, leaders, and community members. Learn more about us and
              our mission.
            </p>
          </article>
          <article>
            <h3>How do I benefit?</h3>
            <p>
              SkillsUSA championships offer practical training and experience in diverse industries.
              Competitions assess skills in many areas. Participation helps students gain valuable
              skills and experience for their future careers.
            </p>
          </article>
          <article>
            <h3>How do I join?</h3>
            <p>
              No matter who you are, no matter where you're from, you've got what it takes to be a
              SkillsUSA champion. To join SkillsUSA click "join" on the header and fill out the form.
            </p>
          </article>
          <article>
            <h3>How do I help out?</h3>
            <p>
              SkillsUSA provides opportunities for students to positively impact their communities.
              Stay up-to-date on volunteer opportunities by checking the events page.
            </p>
          </article>
        </div>
      </section>

      <section class="quote-banner">
        <div class="quote-inner">
          <p>
            "Sometimes the smallest steps in the right direction end up being the biggest steps of your life. Tiptoe if you must, but take a step."
          </p>
          <span class="quote-author">-Naeem Callaway</span>
        </div>
      </section>

      <section class="sponsors-section">
        <div class="sponsors-intro">
          <div class="section-title-row">
            <h2>Sponsors</h2>
            <% if (isAdmin) { %>
              <button class="admin-icon-button admin-add-button" type="button" title="Add sponsor" aria-label="Add sponsor" data-add-type="sponsor">
                <img src="/icons/plus.svg" alt="" aria-hidden="true" />
              </button>
            <% } %>
          </div>
          <p>
            Without the support of our partners, SkillsUSA's vital mission of empowering students to
            become skilled professionals, career-ready leaders and responsible community members
            could never be accomplished. Learn more about the why's and how's of supporting SkillsUSA,
            and help us shape a future we can all be proud of: a future set in skills.
          </p>
        </div>
        <div class="sponsors-grid">
          <% (sponsors || []).forEach((sponsor) => { %>
            <div class="sponsor-card" data-item-type="sponsor" data-id="<%= sponsor.id %>" data-name="<%= sponsor.name %>" data-logo-url="<%= sponsor.logo_url %>" data-link-url="<%= sponsor.link_url %>">
              <% if (isAdmin) { %>
                <div class="news-admin-actions">
                  <button class="admin-icon-button admin-delete-button" type="button" title="Delete sponsor" aria-label="Delete sponsor">
                    <img src="/icons/trash.svg" alt="" aria-hidden="true" />
                  </button>
                  <button class="admin-icon-button admin-edit-button" type="button" title="Edit sponsor" aria-label="Edit sponsor">
                    <img src="/icons/pen.svg" alt="" aria-hidden="true" />
                  </button>
                </div>
              <% } %>
              <div class="sponsor-link" role="link" tabindex="0" aria-label="Visit <%= sponsor.name || 'Sponsor' %>">
                <span class="sponsor-logo">
                  <img src="<%= sponsor.logo_url %>" alt="<%= sponsor.name || 'Sponsor' %> logo" />
                </span>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
      <% if (isAdmin) { %>
        <div class="admin-modal" id="adminSponsorModal" aria-hidden="true">
          <div class="admin-modal-backdrop" data-admin-close></div>
          <div class="admin-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="adminSponsorModalTitle">
            <div class="admin-modal-header">
              <h3 id="adminSponsorModalTitle">Edit sponsor</h3>
              <button class="admin-modal-close" type="button" data-admin-close aria-label="Close">Close</button>
            </div>
            <div class="admin-modal-body">
              <form class="admin-modal-form" id="adminSponsorForm">
                <label for="adminSponsorName">Sponsor name</label>
                <input id="adminSponsorName" name="adminSponsorName" type="text" />

                <label for="adminSponsorLink">Sponsor link</label>
                <input id="adminSponsorLink" name="adminSponsorLink" type="url" placeholder="https://" required />

                <label for="adminSponsorLogo">Logo upload</label>
                <input id="adminSponsorLogo" name="adminSponsorLogo" type="file" accept=".png,.jpg,.jpeg" />
                <p class="admin-modal-hint">PNG or JPG up to 50 MB.</p>

                <div class="admin-modal-actions">
                  <button class="admin-modal-save" type="submit">Save</button>
                  <button class="admin-modal-cancel" type="button" data-admin-close>Cancel</button>
                </div>
              </form>
              <div class="admin-modal-preview">
                <p class="admin-preview-label">Preview</p>
                <div class="admin-preview-card" id="adminSponsorPreview"></div>
              </div>
            </div>
          </div>
        </div>
        <template id="sponsorCardTemplate">
          <div class="sponsor-card" data-item-type="sponsor" data-id="" data-name="" data-logo-url="" data-link-url="" data-is-new="true">
            <div class="news-admin-actions">
              <button class="admin-icon-button admin-delete-button" type="button" title="Delete sponsor" aria-label="Delete sponsor">
                <img src="/icons/trash.svg" alt="" aria-hidden="true" />
              </button>
              <button class="admin-icon-button admin-edit-button" type="button" title="Edit sponsor" aria-label="Edit sponsor">
                <img src="/icons/pen.svg" alt="" aria-hidden="true" />
              </button>
            </div>
            <div class="sponsor-link" role="link" tabindex="0" aria-label="Visit sponsor">
              <span class="sponsor-logo">
                <img src="/icons/placeholder.png" alt="Sponsor logo" />
              </span>
            </div>
          </div>
        </template>
      <% } %>
    </main>
    <%- include('footer') %>
    <script src="/js/main.js"></script>
    <script src="/js/sponsors.js"></script>
  </body>
</html>
