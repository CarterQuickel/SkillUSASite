<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>News & Updates | SkillsUSA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Spectral:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/news.css" />
  </head>
  <body>
    <%- include('header') %>
    <main>
      <section class="hero hero-news">
        <div class="hero-media" role="img" aria-label="SkillsUSA News"></div>
        <div class="hero-content">
          <h1>News and Updates</h1>
          <p class="hero-subtitle">Stay informed about SkillsUSA events and achievements</p>
        </div>
      </section>

            <section class="upcoming-events">
              <div class="events-header">
                <div class="section-title-row">
                  <h2>Upcoming Calendar Events</h2>
                  <% if (isAdmin) { %>
                    <button class="admin-icon-button admin-add-button" type="button" title="Add event" aria-label="Add event" data-add-type="event">
                      <img src="/icons/plus.svg" alt="" aria-hidden="true" />
                    </button>
                  <% } %>
                </div>
                <p>Mark your calendars for these important SkillsUSA dates and events.</p>
              </div>

        <div class="events-grid">
          <% eventItems.forEach((eventItem) => { %>
            <div class="event-card" data-item-type="event" data-id="<%= eventItem.id %>" data-start-date="<%= eventItem.startDate %>" data-end-date="<%= eventItem.endDate || '' %>" data-duration="<%= eventItem.duration || '' %>">
              <% if (isAdmin) { %>
                <div class="news-admin-actions">
                  <button class="admin-icon-button admin-delete-button" type="button" title="Delete event" aria-label="Delete event">
                    <img src="/icons/trash.svg" alt="" aria-hidden="true" />
                  </button>
                  <button class="admin-icon-button admin-edit-button" type="button" title="Edit event" aria-label="Edit event">
                    <img src="/icons/pen.svg" alt="" aria-hidden="true" />
                  </button>
                </div>
              <% } %>
              <div class="event-date<%= eventItem.isMultiDay ? ' multi-day' : '' %>">
                <% if (eventItem.isMultiDay) { %>
                  <div class="date-range">
                    <div class="event-month"><%= eventItem.displayMonth %></div>
                    <div class="date-display"><%= eventItem.displayRange %></div>
                  </div>
                <% } else { %>
                  <div class="event-month"><%= eventItem.displayMonth %></div>
                  <div class="event-day"><%= eventItem.displayDay %></div>
                <% } %>
              </div>
              <div class="event-content">
                <h3><%= eventItem.title %></h3>
                <% if (eventItem.duration) { %>
                  <p class="event-duration">⏱️ <%= eventItem.duration %></p>
                <% } %>
                <p class="event-location event-location-text"><%= eventItem.location ? `📍 ${eventItem.location}` : '' %></p>
                <p class="event-info"><%= eventItem.info %></p>
                <a href="#" class="event-link">Learn More →</a>
              </div>
            </div>
          <% }) %>
        </div>
      </section>

      <section class="news-container">
        <div class="news-header">
          <div class="section-title-row">
            <h2>Latest News</h2>
            <% if (isAdmin) { %>
              <button class="admin-icon-button admin-add-button" type="button" title="Add news" aria-label="Add news" data-add-type="news">
                <img src="/icons/plus.svg" alt="" aria-hidden="true" />
              </button>
            <% } %>
          </div>
          <p>Follow our latest announcements, competition results, and student achievements.</p>
        </div>

        <div class="news-grid">
          <% featuredNews.forEach((newsItem) => { %>
            <article class="news-article featured" data-item-type="news" data-id="<%= newsItem.id %>" data-news-date="<%= newsItem.date %>" data-category="<%= newsItem.category %>">
              <% if (isAdmin) { %>
                <div class="news-admin-actions">
                  <button class="admin-icon-button admin-delete-button" type="button" title="Delete news" aria-label="Delete news">
                    <img src="/icons/trash.svg" alt="" aria-hidden="true" />
                  </button>
                  <button class="admin-icon-button admin-edit-button" type="button" title="Edit news" aria-label="Edit news">
                    <img src="/icons/pen.svg" alt="" aria-hidden="true" />
                  </button>
                </div>
              <% } %>
              <div class="article-image featured-image">
                <img src="<%= newsItem.image_url || '/icons/placeholder.png' %>" alt="Featured article" />
              </div>
              <div class="article-content">
                <div class="article-meta">
                  <span class="article-date news-date"><%= newsItem.displayDate %></span>
                  <span class="article-category featured-category"><%= newsItem.category %></span>
                </div>
                <h3><%= newsItem.title %></h3>
                <p class="news-info"><%= newsItem.info %></p>
                <a href="#" class="read-more">Read Full Story →</a>
              </div>
            </article>
          <% }) %>

          <% regularNews.forEach((newsItem) => { %>
            <article class="news-article" data-item-type="news" data-id="<%= newsItem.id %>" data-news-date="<%= newsItem.date %>" data-category="<%= newsItem.category %>">
              <% if (isAdmin) { %>
                <div class="news-admin-actions">
                  <button class="admin-icon-button admin-delete-button" type="button" title="Delete news" aria-label="Delete news">
                    <img src="/icons/trash.svg" alt="" aria-hidden="true" />
                  </button>
                  <button class="admin-icon-button admin-edit-button" type="button" title="Edit news" aria-label="Edit news">
                    <img src="/icons/pen.svg" alt="" aria-hidden="true" />
                  </button>
                </div>
              <% } %>
              <div class="article-image">
                <img src="<%= newsItem.image_url || '/icons/placeholder.png' %>" alt="News item" />
              </div>
              <div class="article-content">
                <div class="article-meta">
                  <span class="article-date news-date"><%= newsItem.displayDate %></span>
                  <span class="article-category"><%= newsItem.category %></span>
                </div>
                <h3><%= newsItem.title %></h3>
                <p class="news-info"><%= newsItem.info %></p>
                <a href="#" class="read-more">Read More →</a>
              </div>
            </article>
          <% }) %>
        </div>

        <!-- Pagination -->
        <div class="pagination">
          <a href="#" class="page-link active">1</a>
          <a href="#" class="page-link">2</a>
          <a href="#" class="page-link">3</a>
          <a href="#" class="page-link">Next →</a>
        </div>
      </section>

      <section class="news-sidebar">
        <div class="sidebar-widget">
          <h3>Categories</h3>
          <ul class="category-list">
            <li><a href="#">Competition Results</a></li>
            <li><a href="#">Events</a></li>
            <li><a href="#">Student Spotlight</a></li>
            <li><a href="#">Announcements</a></li>
            <li><a href="#">Achievements</a></li>
          </ul>
        </div>

        <div class="sidebar-widget">
          <h3>Subscribe to Updates</h3>
          <p>Get the latest SkillsUSA news delivered to your inbox.</p>
          <form class="subscribe-form">
            <input type="email" placeholder="Your email" required>
            <button type="submit">Subscribe</button>
          </form>
        </div>

        <div class="sidebar-widget">
          <h3>Quick Links</h3>
          <ul class="quick-links">
            <li><a href="/competitions">Competitions</a></li>
            <li><a href="/staff">Meet the Team</a></li>
            <li><a href="/donate">Support SkillsUSA</a></li>
            <li><a href="/contact">Contact Us</a></li>
          </ul>
        </div>
      </section>
      <% if (isAdmin) { %>
        <div class="admin-modal" id="adminEditModal" aria-hidden="true">
          <div class="admin-modal-backdrop" data-admin-close></div>
          <div class="admin-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="adminModalTitle">
            <div class="admin-modal-header">
              <h3 id="adminModalTitle">Edit item</h3>
              <button class="admin-modal-close" type="button" data-admin-close aria-label="Close">Close</button>
            </div>
            <div class="admin-modal-body">
              <form class="admin-modal-form" id="adminEditForm">
                <div class="admin-modal-section" data-admin-section="news">
                  <label for="adminNewsImageFile">Image upload</label>
                  <input id="adminNewsImageFile" name="adminNewsImageFile" type="file" accept=".png,.jpg,.jpeg" />
                  <p class="admin-modal-hint">PNG or JPG up to 50 MB.</p>

                  <label for="adminNewsDate">Date</label>
                  <input id="adminNewsDate" name="adminNewsDate" type="date" required />

                  <label for="adminNewsTitle">Title</label>
                  <input id="adminNewsTitle" name="adminNewsTitle" type="text" />

                  <label for="adminNewsInfo">Info</label>
                  <textarea id="adminNewsInfo" name="adminNewsInfo" rows="5"></textarea>
                </div>

                <div class="admin-modal-section" data-admin-section="event">
                  <label for="adminEventTitle">Event name</label>
                  <input id="adminEventTitle" name="adminEventTitle" type="text" />

                  <label for="adminEventStartDate">Start date</label>
                  <input id="adminEventStartDate" name="adminEventStartDate" type="date" required />

                  <label for="adminEventEndDate">End date (optional)</label>
                  <input id="adminEventEndDate" name="adminEventEndDate" type="date" />

                  <label for="adminEventLocation">Location</label>
                  <input id="adminEventLocation" name="adminEventLocation" type="text" />

                  <label for="adminEventInfo">Info</label>
                  <textarea id="adminEventInfo" name="adminEventInfo" rows="5"></textarea>
                </div>

                <div class="admin-modal-actions">
                  <button class="admin-modal-save" type="submit">Save</button>
                  <button class="admin-modal-cancel" type="button" data-admin-close>Cancel</button>
                </div>
              </form>
              <div class="admin-modal-preview">
                <p class="admin-preview-label">Preview</p>
                <div class="admin-preview-card" id="adminPreviewCard"></div>
              </div>
            </div>
          </div>
        </div>
        <template id="eventCardTemplate">
          <div class="event-card" data-item-type="event" data-id="" data-start-date="" data-end-date="" data-duration="" data-is-new="true">
            <div class="news-admin-actions">
              <button class="admin-icon-button admin-delete-button" type="button" title="Delete event" aria-label="Delete event">
                <img src="/icons/trash.svg" alt="" aria-hidden="true" />
              </button>
              <button class="admin-icon-button admin-edit-button" type="button" title="Edit event" aria-label="Edit event">
                <img src="/icons/pen.svg" alt="" aria-hidden="true" />
              </button>
            </div>
            <div class="event-date">
              <div class="event-month">May</div>
              <div class="event-day">1</div>
            </div>
            <div class="event-content">
              <h3>New event</h3>
              <p class="event-location event-location-text"></p>
              <p class="event-info"></p>
              <a href="#" class="event-link">Learn More →</a>
            </div>
          </div>
        </template>
        <template id="newsCardTemplate">
          <article class="news-article" data-item-type="news" data-id="" data-news-date="" data-category="Announcements" data-is-new="true">
            <div class="news-admin-actions">
              <button class="admin-icon-button admin-delete-button" type="button" title="Delete news" aria-label="Delete news">
                <img src="/icons/trash.svg" alt="" aria-hidden="true" />
              </button>
              <button class="admin-icon-button admin-edit-button" type="button" title="Edit news" aria-label="Edit news">
                <img src="/icons/pen.svg" alt="" aria-hidden="true" />
              </button>
            </div>
            <div class="article-image">
              <img src="/icons/placeholder.png" alt="News image" />
            </div>
            <div class="article-content">
              <div class="article-meta">
                <span class="article-date news-date">May 7, 2026</span>
                <span class="article-category">Announcements</span>
              </div>
              <h3>New update</h3>
              <p class="news-info">Add news details here.</p>
              <a href="#" class="read-more">Read More →</a>
            </div>
          </article>
        </template>
      <% } %>
    <%- include('footer') %>
    <script src="/js/main.js"></script>
    <script src="/js/news.js"></script>
  </body>
</html>