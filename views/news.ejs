<!-- NEWS SECTION -->
<section class="news-section">
  <div class="news-header">
    <h1>SkillsUSA News</h1>

    <% if (isAdmin) { %>
      <button id="openNewsModalBtn" class="admin-btn">
        Add News
      </button>
    <% } %>
  </div>

  <!-- Featured News -->
  <% const featured = newsItems.find(item => item.is_featured); %>

  <% if (featured) { %>
    <div class="featured-news" id="featured-news-<%= featured.id %>">
      <img
        src="<%= featured.image_url %>"
        alt="<%= featured.title %>"
        class="featured-image"
      />

      <div class="featured-content">
        <span class="news-category"><%= featured.category %></span>

        <h2><%= featured.title %></h2>

        <p><%= featured.info %></p>

        <div class="news-meta">
          <span><%= featured.date %></span>

          <% if (isAdmin) { %>
            <div class="admin-controls">
              <button
                class="edit-news-btn"
                data-id="<%= featured.id %>"
                data-title="<%= featured.title %>"
                data-info="<%= featured.info %>"
                data-image="<%= featured.image_url %>"
                data-date="<%= featured.date %>"
                data-category="<%= featured.category %>"
                data-featured="<%= featured.is_featured %>"
              >
                Edit
              </button>

              <button
                class="delete-news-btn"
                data-id="<%= featured.id %>"
              >
                Delete
              </button>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  <% } %>

  <!-- News Grid -->
  <div class="news-grid" id="newsGrid">
    <% newsItems.filter(item => !item.is_featured).forEach(item => { %>
      <div class="news-card" id="news-<%= item.id %>">

        <img
          src="<%= item.image_url %>"
          alt="<%= item.title %>"
          class="news-image"
        />

        <div class="news-content">

          <span class="news-category">
            <%= item.category %>
          </span>

          <h3><%= item.title %></h3>

          <p><%= item.info %></p>

          <div class="news-meta">
            <span><%= item.date %></span>

            <% if (isAdmin) { %>
              <div class="admin-controls">

                <button
                  class="edit-news-btn"
                  data-id="<%= item.id %>"
                  data-title="<%= item.title %>"
                  data-info="<%= item.info %>"
                  data-image="<%= item.image_url %>"
                  data-date="<%= item.date %>"
                  data-category="<%= item.category %>"
                  data-featured="<%= item.is_featured %>"
                >
                  Edit
                </button>

                <button
                  class="delete-news-btn"
                  data-id="<%= item.id %>"
                >
                  Delete
                </button>

              </div>
            <% } %>
          </div>

        </div>
      </div>
    <% }) %>
  </div>
</section>

<!-- ADMIN NEWS MODAL -->
<% if (isAdmin) { %>

<div id="newsModal" class="modal">

  <div class="modal-content">

    <span class="close-modal">&times;</span>

    <h2 id="newsModalTitle">Add News</h2>

    <form id="newsForm">

      <input type="hidden" id="newsId" />

      <div class="form-group">
        <label for="adminNewsTitle">Title</label>

        <input
          type="text"
          id="adminNewsTitle"
          required
        />
      </div>

      <div class="form-group">
        <label for="adminNewsInfo">Info</label>

        <textarea
          id="adminNewsInfo"
          rows="6"
          required
        ></textarea>
      </div>

      <div class="form-group">
        <label for="adminNewsImage">Image URL</label>

        <input
          type="text"
          id="adminNewsImage"
        />
      </div>

      <!-- FIXED -->
      <div class="form-group">
        <label for="adminNewsDate">Date</label>

        <input
          type="date"
          id="adminNewsDate"
          name="adminNewsDate"
          required
        />
      </div>

      <div class="form-group">
        <label for="adminNewsCategory">Category</label>

        <input
          type="text"
          id="adminNewsCategory"
          required
        />
      </div>

      <div class="form-group checkbox-group">

        <input
          type="checkbox"
          id="adminNewsFeatured"
        />

        <label for="adminNewsFeatured">
          Featured News
        </label>

      </div>

      <button type="submit" class="save-btn">
        Save News
      </button>

    </form>

  </div>

</div>

<% } %>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/news.js"></script>