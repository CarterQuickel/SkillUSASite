<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sponsorship | SkillsUSA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Spectral:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/sponsor.css" />
    <link rel="stylesheet" href="/css/news.css" />
  </head>
  <body>
    <%- include('header') %>
    <main>
      <section class="hero hero-sponsor">
        <div class="hero-media" role="img" aria-label="Become a Sponsor"></div>
        <div class="hero-content">
          <h1>Become a Sponsor</h1>
          <p class="hero-subtitle">Partner with SkillsUSA to develop the workforce of tomorrow</p>
        </div>
      </section>

      <section class="sponsor-intro">
        <div class="intro-content">
          <h2>Partnership Opportunity</h2>
          <p>
            SkillsUSA offers a unique opportunity for businesses and organizations to invest in the
            next generation of skilled workers while building brand visibility and community goodwill.
            Partner with us to develop career-ready professionals who will drive your industry forward.
          </p>
          <p>
            Corporate sponsors play a vital role in our mission to empower students to become skilled
            professionals, leaders, and engaged community members. Your partnership directly supports
            competitions, training programs, and the development of future talent in your industry.
          </p>
        </div>
      </section>

      <section class="sponsorship-benefits">
        <h2 class="section-title">Why Sponsor SkillsUSA?</h2>
        <div class="benefits-grid">
          <div class="benefit-card">
            <h3>Access to Talent</h3>
            <p>
              Connect with motivated, skilled students who are preparing for careers in your industry.
              Sponsor students often become your most dedicated employees.
            </p>
          </div>

          <div class="benefit-card">
            <h3>Brand Visibility</h3>
            <p>
              Gain exposure through event sponsorships, competitions, and promotional materials. Your
              company name will be recognized as a workforce development leader.
            </p>
          </div>

          <div class="benefit-card">
            <h3>Community Impact</h3>
            <p>
              Demonstrate your commitment to education and community development. Build goodwill and
              strengthen relationships with customers and community members.
            </p>
          </div>

          <div class="benefit-card">
            <h3>Workforce Development</h3>
            <p>
              Help shape the skills and competencies of future workers in your field. Have a direct
              impact on the educational curriculum and training standards.
            </p>
          </div>
        </div>
      </section>

      <section class="sponsorship-tiers">
        <h2 class="section-title">Sponsorship Levels</h2>
        <div class="tiers-grid">
          <div class="tier-card">
            <div class="tier-header gold-tier">
              <h3>Gold Sponsor</h3>
              <p class="tier-range">$1,000</p>
            </div>
            <ul class="tier-benefits">
              <li>✓ Logo on event materials</li>
              <li>✓ Recognition on website</li>
              <li>✓ Social media promotion</li>
              <li>✓ 2 event tickets</li>
              <li>✓ Certificate of sponsorship</li>
            </ul>
          </div>

          <div class="tier-card featured">
            <div class="tier-header platinum-tier">
              <h3>Platinum Sponsor</h3>
              <p class="tier-range">$2,500</p>
            </div>
            <ul class="tier-benefits">
              <li>✓ Premium logo placement</li>
              <li>✓ Event signage</li>
              <li>✓ Newsletter feature</li>
              <li>✓ 4 event tickets</li>
              <li>✓ Booth at competition</li>
              <li>✓ Recognition at events</li>
            </ul>
          </div>

          <div class="tier-card">
            <div class="tier-header diamond-tier">
              <h3>Diamond Sponsor</h3>
              <p class="tier-range">$5,000</p>
            </div>
            <ul class="tier-benefits">
              <li>✓ Exclusive naming rights</li>
              <li>✓ Featured event signage</li>
              <li>✓ Premium newsletter placement</li>
              <li>✓ 6 event tickets</li>
              <li>✓ Prime booth location</li>
              <li>✓ Speaking opportunity</li>
              <li>✓ Custom recognition package</li>
            </ul>
          </div>
        </div>
      </section>

      <main class="contact-container">
      <div class="contact-intro">
        <h2>Ready to Sponsor SkillsUSA?</h2>
        <p>Use the form below to contact us and submit sponsorship information.</p>
      </div>

      <div class="form-container">
        <form class="contact-form" method="POST" action="/sponsor" enctype="multipart/form-data">
          <div class="form-row">
            <div class="form-group">
              <label for="company">Company Name *</label>
              <input type="text" id="company" name="company" required />
            </div>
            <div class="form-group">
              <label for="contact">Contact Person *</label>
              <input type="text" id="contact" name="contact" required />
            </div>
          </div>

          <div class="form-group">
            <label for="email">Email Address *</label>
            <input type="email" id="email" name="email" required />
          </div>

          <div class="form-group">
            <label>Sponsorship Tier *</label>
            <div class="radio-group">
              <div class="radio-option">
                <input type="radio" id="gold" name="tier" value="Gold" required />
                <label for="gold">$1000 - Gold Sponsor</label>
              </div>
              <div class="radio-option">
                <input type="radio" id="platinum" name="tier" value="Platinum" />
                <label for="platinum">$2500 - Platinum Sponsor</label>
              </div>
              <div class="radio-option">
                <input type="radio" id="diamond" name="tier" value="Diamond" />
                <label for="diamond">$5000 - Diamond Sponsor</label>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label for="logo">Company Logo *</label>
            <input type="file" id="logo" name="logo" accept="image/*" required />
          </div>

          <div class="form-group">
            <label for="message">Additional Information</label>
            <textarea id="message" name="message" placeholder="Tell us more about your company or sponsorship interests..."></textarea>
          </div>

          <button type="submit" class="form-button">Submit</button>
        </form>
      </div>

      <section class="current-sponsors">
        <div class="section-title-row">
          <h2 class="section-title">Our Valued Sponsors</h2>
          <% if (isAdmin) { %>
            <button class="admin-icon-button admin-add-button" type="button" title="Add sponsor" aria-label="Add sponsor" data-add-type="sponsor">
              <img src="/icons/plus.svg" alt="" aria-hidden="true" />
            </button>
          <% } %>
        </div>
        <p class="sponsors-intro">We are grateful for the support of our corporate partners and sponsors who make SkillsUSA possible.</p>
        <div class="sponsors-grid">
          <% (sponsors || []).forEach((sponsor) => { %>
            <div class="sponsor-card" data-item-type="sponsor" data-id="<%= sponsor.id %>" data-name="<%= sponsor.name %>" data-logo-url="<%= sponsor.logo_url %>" data-link-url="<%= sponsor.link_url %>">
              <% if (isAdmin) { %>
                <div class="news-admin-actions">
                  <button class="admin-icon-button admin-delete-button" type="button" title="Delete sponsor" aria-label="Delete sponsor">
                    <img src="/icons/trash.svg" alt="" aria-hidden="true" />
                  </button>
                  <button class="admin-icon-button admin-edit-button" type="button" title="Edit sponsor" aria-label="Edit sponsor">
                    <img src="/icons/pen.svg" alt="" aria-hidden="true" />
                  </button>
                </div>
              <% } %>
              <div class="sponsor-link" role="link" tabindex="0" aria-label="Visit <%= sponsor.name || 'Sponsor' %>">
                <span class="sponsor-logo">
                  <img src="<%= sponsor.logo_url %>" alt="<%= sponsor.name || 'Sponsor' %> logo" />
                </span>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
      <% if (isAdmin) { %>
        <div class="admin-modal" id="adminSponsorModal" aria-hidden="true">
          <div class="admin-modal-backdrop" data-admin-close></div>
          <div class="admin-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="adminSponsorModalTitle">
            <div class="admin-modal-header">
              <h3 id="adminSponsorModalTitle">Edit sponsor</h3>
              <button class="admin-modal-close" type="button" data-admin-close aria-label="Close">Close</button>
            </div>
            <div class="admin-modal-body">
              <form class="admin-modal-form" id="adminSponsorForm">
                <label for="adminSponsorName">Sponsor name</label>
                <input id="adminSponsorName" name="adminSponsorName" type="text" />

                <label for="adminSponsorLink">Sponsor link</label>
                <input id="adminSponsorLink" name="adminSponsorLink" type="url" placeholder="https://" required />

                <label for="adminSponsorLogo">Logo upload</label>
                <input id="adminSponsorLogo" name="adminSponsorLogo" type="file" accept=".png,.jpg,.jpeg" />
                <p class="admin-modal-hint">PNG or JPG up to 50 MB.</p>

                <div class="admin-modal-actions">
                  <button class="admin-modal-save" type="submit">Save</button>
                  <button class="admin-modal-cancel" type="button" data-admin-close>Cancel</button>
                </div>
              </form>
              <div class="admin-modal-preview">
                <p class="admin-preview-label">Preview</p>
                <div class="admin-preview-card" id="adminSponsorPreview"></div>
              </div>
            </div>
          </div>
        </div>
        <template id="sponsorCardTemplate">
          <div class="sponsor-card" data-item-type="sponsor" data-id="" data-name="" data-logo-url="" data-link-url="" data-is-new="true">
            <div class="news-admin-actions">
              <button class="admin-icon-button admin-delete-button" type="button" title="Delete sponsor" aria-label="Delete sponsor">
                <img src="/icons/trash.svg" alt="" aria-hidden="true" />
              </button>
              <button class="admin-icon-button admin-edit-button" type="button" title="Edit sponsor" aria-label="Edit sponsor">
                <img src="/icons/pen.svg" alt="" aria-hidden="true" />
              </button>
            </div>
            <div class="sponsor-link" role="link" tabindex="0" aria-label="Visit sponsor">
              <span class="sponsor-logo">
                <img src="/icons/placeholder.png" alt="Sponsor logo" />
              </span>
            </div>
          </div>
        </template>
      <% } %>
    </main>
    <%- include('footer') %>
    <script src="/js/main.js"></script>
    <script src="/js/sponsors.js"></script>
  </body>
</html>
