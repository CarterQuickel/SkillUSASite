      <div class="utility-content">
        <div class="utility-contact">
          <span class="utility-item">&#128222; 717-652-3170</span>
          <span class="utility-item">&#9993; jhaste@dcts.org</span>
        </div>
        <div class="utility-icons">
          <span class="icon-circle">&#128270;</span>
          <span class="icon-circle">f</span>
          <span class="icon-circle">&#9679;</span>
        </div>
      </div>
    </div>

    <header class="site-header">
      <div class="nav-wrapper">
        <div class="logo">SkillsUSA<br /><span>York County School of Technology</span></div>
        <nav class="main-nav" aria-label="Main">
          <a href="/">Home</a>
          <div class="nav-item">
            <a href="/about">About Us</a>
            <div class="submenu" role="menu" aria-label="About submenu">
              <a href="/about" role="menuitem">About</a>
              <a href="/staff" role="menuitem">Staff</a>
              <a href="/contact" role="menuitem">Contact</a>
            </div>
          </div>
          <a href="/competitions">Competitions</a>
          <div class="nav-item">
            <a href="#">Support</a>
            <div class="submenu" role="menu" aria-label="Support submenu">
              <a href="/donate" role="menuitem">Donate</a>
              <a href="/sponsor" role="menuitem">Sponsor</a>
            </div>
          </div>
          <a href="/news">News</a>
          <a href="/photos" class="active">Photos</a>
        </nav>
        <a class="cta" href="#">Join SkillsUSA &#8594;</a>
      </div>
    </header>

    <main>
      <section class="hero hero-photos">
        <div class="hero-media" role="img" aria-label="SkillsUSA Photo Gallery"></div>
        <div class="hero-content">
          <h1>Photo Gallery</h1>
          <p class="hero-subtitle">Explore moments from our SkillsUSA events and celebrations</p>
        </div>
      </section>

      <section class="photos-intro">
        <h2>Our Photo Albums</h2>
        <p>
          Browse through our collection of memorable moments from SkillsUSA competitions, team 
          events, and student achievements. Click on any album to view all photos.
        </p>
      </section>

      <!-- Photo Albums Grid -->
      <section class="albums-container">
        <div class="albums-grid">
          <!-- Album 1: State Championship -->
          <div class="album-card">
            <div class="album-image" style="background: linear-gradient(135deg, #c9a24c 0%, #b38c3f 100%); position: relative; overflow: hidden;">
              <div class="album-placeholder">
                <span style="font-size: 3rem;">&#127945;</span>
              </div>
              <div class="album-overlay">
                <h3>State Championship</h3>
                <p class="photo-count">18 Photos</p>
                <a href="#" class="view-album">View Album →</a>
              </div>
            </div>
            <div class="album-info">
              <h3>State Championship 2025</h3>
              <p>Highlights from our state-level competition featuring top technical skills.</p>
              <p class="date-posted">July 2025</p>
            </div>
          </div>

          <!-- Album 2: Regional Qualifiers -->
          <div class="album-card">
            <div class="album-image" style="background: linear-gradient(135deg, #0a2147 0%, #05162f 100%); position: relative; overflow: hidden;">
              <div class="album-placeholder">
                <span style="font-size: 3rem;">&#127953;</span>
              </div>
              <div class="album-overlay">
                <h3>Regional Qualifiers</h3>
                <p class="photo-count">24 Photos</p>
                <a href="#" class="view-album">View Album →</a>
              </div>
            </div>
            <div class="album-info">
              <h3>Regional Qualifiers 2025</h3>
              <p>Action shots from our regional competition rounds across multiple venues.</p>
              <p class="date-posted">June 2025</p>
            </div>
          </div>

          <!-- Album 3: Leadership Conference -->
          <div class="album-card">
            <div class="album-image" style="background: linear-gradient(135deg, #12457a 0%, #1c61d0 100%); position: relative; overflow: hidden;">
              <div class="album-placeholder">
                <span style="font-size: 3rem;">&#127904;</span>
              </div>
              <div class="album-overlay">
                <h3>Leadership Conference</h3>
                <p class="photo-count">31 Photos</p>
                <a href="#" class="view-album">View Album →</a>
              </div>
            </div>
            <div class="album-info">
              <h3>Leadership Training 2025</h3>
              <p>Candid moments from our 3-day leadership development intensive workshop.</p>
              <p class="date-posted">May 2025</p>
            </div>
          </div>

          <!-- Album 4: Team Activities -->
          <div class="album-card">
            <div class="album-image" style="background: linear-gradient(135deg, #b1292b 0%, #8e1f1f 100%); position: relative; overflow: hidden;">
              <div class="album-placeholder">
                <span style="font-size: 3rem;">&#128187;</span>
              </div>
              <div class="album-overlay">
                <h3>Team Activities</h3>
                <p class="photo-count">20 Photos</p>
                <a href="#" class="view-album">View Album →</a>
              </div>
            </div>
            <div class="album-info">
              <h3>Team Building Activities</h3>
              <p>Photos from team bonding sessions, workshops, and collaborative events.</p>
              <p class="date-posted">April 2025</p>
            </div>
          </div>

          <!-- Album 5: Student Achievements -->
          <div class="album-card">
            <div class="album-image" style="background: linear-gradient(135deg, #2d5f2e 0%, #1a381a 100%); position: relative; overflow: hidden;">
              <div class="album-placeholder">
                <span style="font-size: 3rem;">&#127891;</span>
              </div>
              <div class="album-overlay">
                <h3>Student Achievements</h3>
                <p class="photo-count">27 Photos</p>
                <a href="#" class="view-album">View Album →</a>
              </div>
            </div>
            <div class="album-info">
              <h3>Award Winners & Achievements</h3>
              <p>Celebration photos of our award-winning students and their accomplishments.</p>
              <p class="date-posted">March 2025</p>
            </div>
          </div>

          <!-- Album 6: Community Outreach -->
          <div class="album-card">
            <div class="album-image" style="background: linear-gradient(135deg, #5c4033 0%, #3e2723 100%); position: relative; overflow: hidden;">
              <div class="album-placeholder">
                <span style="font-size: 3rem;">&#127881;</span>
              </div>
              <div class="album-overlay">
                <h3>Community Events</h3>
                <p class="photo-count">15 Photos</p>
                <a href="#" class="view-album">View Album →</a>
              </div>
            </div>
            <div class="album-info">
              <h3>Community Outreach 2025</h3>
              <p>SkillsUSA members volunteering and engaging with the local community.</p>
              <p class="date-posted">February 2025</p>
            </div>
          </div>
        </div>
      </section>
