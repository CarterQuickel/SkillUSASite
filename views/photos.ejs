<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Photos | SkillsUSA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Spectral:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/photos.css" />
    <link rel="stylesheet" href="/css/album.css">
    <link rel="stylesheet" href="/css/news.css" />
  </head>
  <body>
    <%- include('header') %>
    <main>
      <section class="hero hero-photos">
        <div class="hero-media" role="img" aria-label="SkillsUSA Photo Gallery"></div>
        <div class="hero-content">
          <h1>Photo Gallery</h1>
          <p class="hero-subtitle">Explore moments from our SkillsUSA events and celebrations</p>
        </div>
      </section>

      <section class="photos-intro">
        <div class="section-title-row">
          <h2>Our Photo Albums</h2>
          <% if (isAdmin) { %>
            <button class="admin-icon-button admin-add-button" type="button" title="Add album" aria-label="Add album" data-add-type="album">
              <img src="/icons/plus.svg" alt="" aria-hidden="true" />
            </button>
          <% } %>
        </div>
        <p>
          Browse through our collection of memorable moments from SkillsUSA competitions, team 
          events, and student achievements. Click on any album to view all photos.
        </p>
      </section>
      <!-- import the album.tsx file below -->
      <div id="albums-grid">
        <% (albums || []).forEach((album) => { %>
          <div class="album-shell" data-album-id="<%= album.id %>" data-title="<%= album.title %>" data-description="<%= album.description %>" data-folder="<%= album.folder %>">
            <% if (isAdmin) { %>
              <div class="news-admin-actions">
                <button class="admin-icon-button admin-delete-button" type="button" title="Delete album" aria-label="Delete album">
                  <img src="/icons/trash.svg" alt="" aria-hidden="true" />
                </button>
                <button class="admin-icon-button admin-edit-button" type="button" title="Edit album" aria-label="Edit album">
                  <img src="/icons/pen.svg" alt="" aria-hidden="true" />
                </button>
              </div>
            <% } %>
            <div
              class="album"
              data-title="<%= album.title %>"
              data-description="<%= album.description %>"
              data-folder="<%= album.folder %>"
            ></div>
          </div>
        <% }) %>
      </div>
      <% if (isAdmin) { %>
        <div class="admin-modal" id="adminAlbumModal" aria-hidden="true">
          <div class="admin-modal-backdrop" data-admin-close></div>
          <div class="admin-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="adminAlbumModalTitle">
            <div class="admin-modal-header">
              <h3 id="adminAlbumModalTitle">Edit album</h3>
              <button class="admin-modal-close" type="button" data-admin-close aria-label="Close">Close</button>
            </div>
            <div class="admin-modal-body">
              <form class="admin-modal-form" id="adminAlbumForm">
                <label for="adminAlbumTitle">Album name</label>
                <input id="adminAlbumTitle" name="adminAlbumTitle" type="text" required />

                <label for="adminAlbumFolder">Album folder</label>
                <input id="adminAlbumFolder" name="adminAlbumFolder" type="text" required />
                <p class="admin-modal-hint">Letters, numbers, hyphens, and underscores only.</p>

                <label for="adminAlbumDescription">Description</label>
                <textarea id="adminAlbumDescription" name="adminAlbumDescription" rows="5" required></textarea>

                <label for="adminAlbumImages">Add images</label>
                <input id="adminAlbumImages" name="adminAlbumImages" type="file" accept=".png,.jpg,.jpeg" multiple />
                <p class="admin-modal-hint">Upload JPG or PNG images for this album.</p>

                <label for="adminAlbumFolderImages">Add image folder</label>
                <input id="adminAlbumFolderImages" name="adminAlbumFolderImages" type="file" accept=".png,.jpg,.jpeg" webkitdirectory directory multiple />
                <p class="admin-modal-hint">Choose a folder to upload all images inside.</p>

                <div class="admin-modal-actions">
                  <button class="admin-modal-save" type="submit">Save</button>
                  <button class="admin-modal-cancel" type="button" data-admin-close>Cancel</button>
                </div>
              </form>
              <div class="admin-modal-preview">
                <p class="admin-preview-label">Current images</p>
                <div class="album-admin-images" id="adminAlbumImagesList"></div>
              </div>
            </div>
          </div>
        </div>
      <% } %>
      <script src="/album.js"></script>
    </main>
    <%- include('footer') %>
    <script src="/js/main.js"></script>
    <script src="/js/photos-admin.js"></script>
  </body>
</html>
