<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Photos | SkillsUSA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Spectral:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/photos.css" />
    <link rel="stylesheet" href="/css/album.css">
  </head>
  <body>
    <%- include('header') %>
    <main>
      <section class="hero hero-photos">
        <div class="hero-media" role="img" aria-label="SkillsUSA Photo Gallery"></div>
        <div class="hero-content">
          <h1>Photo Gallery</h1>
          <p class="hero-subtitle">Explore moments from our SkillsUSA events and celebrations</p>
        </div>
      </section>

      <section class="photos-intro">
        <h2>Our Photo Albums</h2>
        <p>
          Browse through our collection of memorable moments from SkillsUSA competitions, team 
          events, and student achievements. Click on any album to view all photos.
        </p>
      </section>
      <!-- import the album.tsx file below -->
      <div id="albums-grid">
        <div
          class="album"
          data-title="Dec. 11, 2025 - Student Council & SkillsUSA Free Hunger York Event"
          data-description="The students of SkillsUSA York County School of Technology participated in the Free Hunger York event, a community initiative to combat food insecurity. Through their efforts, they helped collect and distribute food to those in need, making a positive impact on the local community."
          data-folder="freeHungerYork"
        ></div>
        <div
          class="album"
          data-title="Nov. 7, 2024 - SkillsUSA PA State Leadership and Skills Conference"
          data-description="On November 7, 2024, SkillsUSA PA State Leadership and Skills Conference took place, showcasing the talents and dedication of students from across Pennsylvania. The event featured a variety of competitions, workshops, and networking opportunities, fostering leadership development and skill-building among participants."
          data-folder="1172024"
        ></div>
        <div
          class="album"
          data-title="April 2-4, 2025 - SkillsUSA National Leadership and Skills Conference"
          data-description="The SkillsUSA National Leadership and Skills Conference is an annual event that brings together students from across the nation to compete in various technical and leadership competitions. This year's conference featured a wide range of activities designed to foster growth and development among participants."
          data-folder="422025"
        ></div>
        <div
          class="album"
          data-title="Dec. 17, 2024 - FFA and SkillsUSA"
          data-description="Students from FFA and SkillsUSA came together for a community service field trip to New Bridgeville to prune trees and help with landscaping. This collaborative effort showcased the dedication of both organizations to giving back to the community and fostering teamwork among students."
          data-folder="12172024"
        ></div>
        <div
          class="album"
          data-title="Jan. 28, 2025 - SkillsUSA"
          data-description="SkillsUSA members participated in an organizational meeting and awards ceremony."
          data-folder="1282025"
        ></div>
      </div>
      <script src="/album.js"></script>
    </main>
    <%- include('footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
