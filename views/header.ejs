<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SkillsUSA Bars Template</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Spectral:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/home.css" />
  </head>
  <body>
    <div class="utility-bar">
      <div class="utility-content">
        <div class="utility-contact">
          <span class="utility-item">&#128222; 717-652-3170</span>
          <span class="utility-item">&#9993; jhaste@dcts.org</span>
        </div>
        <div class="utility-icons">
          <span class="icon-circle"><img src="/icons/facebook-icon.png" alt="Facebook" width="20" height="20" /></span>
          <span class="icon-circle"><img src="/icons/instagram-icon.png" alt="Instagram" width="24" height="24" /></span>
        </div>
      </div>
    </div>

    <header class="site-header">
      <div class="nav-wrapper">
        <div class="logo">SkillsUSA<br /><span>York County School of Technology</span></div>
        <nav class="main-nav" aria-label="Main">
          <a href="/">Home</a>
          <div class="nav-item">
            <a href="#">About Us</a>
            <div class="submenu" role="menu" aria-label="About submenu">
              <a href="/about" role="menuitem">About</a>
              <a href="/staff" role="menuitem">Staff</a>
              <a href="/contact" role="menuitem">Contact</a>
            </div>
          </div>
          <a href="/competitions">Competitions</a>
          <div class="nav-item">
            <a href="#">Support</a>
            <div class="submenu" role="menu" aria-label="Support submenu">
              <a href="/donate" role="menuitem">Donate</a>
              <a href="/sponsor" role="menuitem">Sponsor</a>
            </div>
          </div>
          <a href="/news">News</a>
          <a href="/photos">Photos</a>
        </nav>
        <a class="cta" href="#">Join SkillsUSA &#8594;</a>
      </div>
    </header>
  </body>
  <script>
    // turns the text gold if its on the current page
    const currentPath = window.location.pathname;
    const navLinks = document.querySelectorAll('.main-nav a');

    navLinks.forEach(link => {
      if (link.getAttribute('href') === currentPath) {
        link.style.color = '#b38c3f';
      }
    });
  </script>
</html>
