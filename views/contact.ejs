<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Contact SkillsUSA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Spectral:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/contact.css" />
  </head>
  <body>
    <%- include('header') %>

    <section class="hero-contact">
      <div class="hero-media"></div>
      <div class="hero-content">
        <h1>Get In Touch</h1>
        <p class="hero-subtitle">We'd love to hear from you!</p>
      </div>
    </section>

    <main class="contact-container">
      <div class="contact-intro">
        <h2>Have a question or feedback?</h2>
        <p>Use the form below to get in touch with our SkillsUSA team. We'll respond as soon as possible.</p>
      </div>

      <form class="contact-form" method="POST" action="/contact" onsubmit="console.log('Form submitted'); return true;">
        <div class="form-row">
          <div class="form-group">
            <label for="name">Full Name *</label>
            <input type="text" id="name" name="name" required />
          </div>
          <div class="form-group">
            <label for="email">Email Address *</label>
            <input type="email" id="email" name="email" required />
          </div>
        </div>

        <div class="form-group">
          <label for="subject">Subject *</label>
          <input type="text" id="subject" name="subject" required />
        </div>

        <div class="form-group">
          <label for="message">Message *</label>
          <textarea id="message" name="message" required></textarea>
        </div>

        <button type="submit" class="form-button">Send Message</button>
      </form>

      <div class="contact-info">
        <div class="info-box">
          <h3>Location</h3>
          <p>2179 S Queen Street<br />York, PA 17402</p>
        </div>
        <div class="info-box">
          <h3>Phone</h3>
          <p>717-741-0820</p>
        </div>
        <div class="info-box">
          <h3>Email</h3>
          <p>mbalsavage@ytech.edu</p>
        </div>
      </div>
    </main>

    <%- include('footer') %>
  </body>
</html>
