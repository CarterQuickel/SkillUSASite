        </div>
      </section>

      <!-- Officers Section -->
      <section class="team-section">
        <div class="team-section-header">
          <h2>Officers</h2>
          <p>Leadership driving SkillsUSA forward</p>
        </div>
        <div class="team-grid">
          <div class="team-member">
            <div class="member-image">
              <img src="https://via.placeholder.com/300x400?text=Officer+1" alt="Officer 1" />
            </div>
            <div class="member-info">
              <h3>Officer Name</h3>
              <p class="member-role">President</p>
