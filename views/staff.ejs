<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Staff | SkillsUSA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Spectral:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/staff.css" />
  </head>
  <body>
    <%- include('header') %>
    <main>
      <!-- Advisors Section -->
      <section class="team-section advisors-section">
        <div class="team-section-header">
          <h2>Advisors</h2>
          <p>Dedicated mentors supporting our members</p>
        </div>
        <div class="team-grid">
          <div class="team-member">
            <div class="member-image">
              <img src="https://via.placeholder.com/300x400?text=Advisor+1" alt="Advisor 1" />
            </div>
            <div class="member-info">
              <h3>Advisor Name</h3>
              <p class="member-role">SkillsUSA Advisor</p>
              <p class="member-bio">Brief description of their background and experience as an advisor.</p>
            </div>
          </div>

          <div class="team-member">
            <div class="member-image">
              <img src="https://via.placeholder.com/300x400?text=Advisor+2" alt="Advisor 2" />
