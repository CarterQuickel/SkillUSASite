          <div class="team-member">
            <div class="member-image">
              <img src="https://via.placeholder.com/300x400?text=Advisor+5" alt="Advisor 5" />
            </div>
            <div class="member-info">
              <h3>Advisor Name</h3>
              <p class="member-role">SkillsUSA Advisor</p>
