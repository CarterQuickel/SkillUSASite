<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Staff | SkillsUSA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Spectral:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/staff.css" />
  </head>
  <body>
    <%- include('header') %>
    <main>
      <!-- Advisors Section -->
      <section class="team-section advisors-section">
        <div class="team-section-header">
          <h2>Advisors</h2>
          <p>Dedicated mentors supporting our members</p>
        </div>
        <div class="team-grid">
          <% if (advisors && advisors.length) { %>
            <% advisors.forEach((member) => { %>
              <% const imageSrc = "/icons/placeholder.png"; %>
              <div class="team-member">
                <div class="member-image">
                  <img src="<%= imageSrc %>" alt="<%= member.name %>" />
                </div>
                <div class="member-info">
                  <h3><%= member.name %></h3>
                  <p class="member-role"><%= member.role %></p>
                  <p class="member-bio"><%= member.bio %></p>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <p>No advisors are listed yet.</p>
          <% } %>
        </div>
      </section>

      <!-- Officers Section -->
      <section class="team-section">
        <div class="team-section-header">
          <h2>Officers</h2>
          <p>Leadership driving SkillsUSA forward</p>
        </div>
        <div class="team-grid">
          <% if (officers && officers.length) { %>
            <% officers.forEach((member) => { %>
              <% const imageSrc = "/icons/placeholder.png"; %>
              <div class="team-member">
                <div class="member-image">
                  <img src="<%= imageSrc %>" alt="<%= member.name %>" />
                </div>
                <div class="member-info">
                  <h3><%= member.name %></h3>
                  <p class="member-role"><%= member.role %></p>
                  <p class="member-bio"><%= member.bio %></p>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <p>No officers are listed yet.</p>
          <% } %>
        </div>
      </section>
    </main>
    <%- include('footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
