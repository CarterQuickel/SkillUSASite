<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin | SkillsUSA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Spectral:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <main class="form-page">
      <section class="form-card">
        <h1>Welcome, <%= username %></h1>
        <p>You are signed in as the admin.</p>
        <form action="/admin/logout" method="post">
          <button type="submit" class="hero-button">Log Out</button>
        </form>
        <p class="form-footer">
          <a href="/">Return to home</a>
        </p>
      </section>
    </main>
  </body>
</html>
